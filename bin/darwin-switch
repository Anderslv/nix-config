#!/usr/bin/env bash
set -euo pipefail

# darwin-switch [switch|build|check|...] [darwin-rebuild args...]
#
# darwin-rebuild for this repo's Mac. Its username and hostname aren't in the
# repo: they are decrypted from ~/.config/nix-secrets/host.yaml (written by
# nix-secrets-setup) and passed to the flake as environment variables, which
# is why it evaluates with --impure.

repo="${NIX_CONFIG_DIR:-$(git rev-parse --show-toplevel)}"
host_file="${NIX_SECRETS_DIR:-$HOME/.config/nix-secrets}/host.yaml"
export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"

if [[ ! -f "$host_file" || ! -f "$SOPS_AGE_KEY_FILE" ]]; then
	echo "No host secrets on this machine yet; run nix-secrets-setup first." >&2
	exit 1
fi

NIX_CONFIG_USERNAME="$(sops decrypt --extract '["username"]' "$host_file")"
NIX_CONFIG_HOSTNAME="$(sops decrypt --extract '["hostname"]' "$host_file")"
export NIX_CONFIG_USERNAME NIX_CONFIG_HOSTNAME

action="${1:-switch}"
shift || true
rebuild=("$(command -v darwin-rebuild)" "$action" --impure --flake "$repo#$NIX_CONFIG_HOSTNAME" "$@")

# Only activating needs root.
if [[ "$action" == build ]]; then
	exec "${rebuild[@]}"
fi
exec sudo --preserve-env=NIX_CONFIG_USERNAME,NIX_CONFIG_HOSTNAME "${rebuild[@]}"
